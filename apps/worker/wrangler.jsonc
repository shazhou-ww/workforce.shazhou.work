{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workforce",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_NAME": "Workforce",
    "COLLECTION_ENABLED": "true",
    "COLLECTION_ADMIN_GITHUB_IDS": "242885595",
    "PUBLIC_ACTIVITY_GITHUB_ID": "242885595",
  },
  // Custom domains are bootstrapped in Cloudflare, not managed by releases.
  "workers_dev": false,
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "089f1568861443d9b6e1bf9d2dc808cb",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workforce-activity",
      "database_id": "a871612e-91f5-43d5-a07c-45612b5bc4a4",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "binding": "COLLECTION",
      "name": "workforce-activity",
      "class_name": "ActivityCollection",
    },
  ],
  // Hourly personal collections only; the public source uses the same personal run.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": {
    "enabled": true,
  },
}
