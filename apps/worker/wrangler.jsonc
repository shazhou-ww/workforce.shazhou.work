{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workforce",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_NAME": "Workforce",
  },
  // Custom domains are bootstrapped in Cloudflare, not managed by releases.
  "workers_dev": false,
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "089f1568861443d9b6e1bf9d2dc808cb",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
