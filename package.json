{
  "name": "workforce",
  "version": "0.0.0",
  "description": "Read-only public GitHub activity dashboard on Cloudflare.",
  "keywords": [
    "typescript",
    "cloudflare",
    "workers",
    "react",
    "hono",
    "github",
    "dashboard"
  ],
  "homepage": "https://workforce.shazhou.work",
  "bugs": {
    "url": "https://github.com/shazhou-ww/workforce.shazhou.work/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/workforce.shazhou.work.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "turbo run build",
    "collect": "pnpm --filter @workspace/contracts build && node apps/worker/scripts/collect.ts",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('.turbo', { recursive: true, force: true })\"",
    "deploy": "pnpm build && pnpm --filter @workspace/worker run deploy",
    "dev": "pnpm --filter @workspace/web build && turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@auth/core": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@fontsource-variable/instrument-sans": "catalog:",
    "@fontsource-variable/newsreader": "catalog:",
    "@hono/auth-js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "hono": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
