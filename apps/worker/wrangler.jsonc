{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workforce",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_NAME": "Workforce",
  },
  "routes": [{ "pattern": "workforce.shazhou.work", "custom_domain": true }],
  "kv_namespaces": [
    {
      "binding": "STATS",
      // Replace with the namespace ID before remote writes or deployment.
      "id": "00000000000000000000000000000000",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
